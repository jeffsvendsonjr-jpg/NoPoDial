    <string name="app_name">NoPoDial</string>
    <string name="tagline">Pocket-dial protection with zero idle battery cost. NoPoDial sleeps until a call actually happens, then checks whether your phone dialed from a pocket and texts the other side so they don\'t call back.</string>
