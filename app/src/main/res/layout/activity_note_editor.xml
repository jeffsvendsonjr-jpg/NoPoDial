<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_note_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/input_note_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_note_body"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top"
            android:minLines="5"
            android:autofillHints=""
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/button_save_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_note"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remind_label"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_remind_1h"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/remind_1h" />

            <Button
                android:id="@+id/button_remind_tomorrow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/remind_tomorrow" />

            <Button
                android:id="@+id/button_remind_pick"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remind_pick" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
